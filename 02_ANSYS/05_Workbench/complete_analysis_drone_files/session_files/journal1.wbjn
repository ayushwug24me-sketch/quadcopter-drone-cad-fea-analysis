    Variables=["Young's Modulus"],
    Values=[["2.1 [Pa]"]])
matlProp2.SetVariableProperty(
    VariableName="Young's Modulus",
    Property="Unit",
    Value="GPa")
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2.1E-09 [GPa]"]])
matlProp2.SetVariableProperty(
    VariableName="Young's Modulus",
    Property="Unit",
    Value="Pa")
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2.1 [Pa]"]])
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2 [Pa]"]])
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2.1 [Pa]"]])
matlProp2.SetVariableProperty(
    VariableName="Young's Modulus",
    Property="Unit",
    Value="GPa")
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2.1E-09 [GPa]"]])
matlProp2.SetData(
    Variables=["Poisson's Ratio"],
    Values=[["0.35"]])
matlProp3 = matl1.CreateProperty(
    Name="Tensile Yield Strength",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp3.SetData(
    Index=-1,
    Variables=["Tensile Yield Strength"],
    Values=[["50 [Pa]"]])
matlProp3.SetVariableProperty(
    VariableName="Tensile Yield Strength",
    Property="Unit",
    Value="MPa")
matlProp3.SetData(
    Variables=["Tensile Yield Strength"],
    Values=[["4.9999999999999996E-05 [MPa]"]])
matlProp2.SetVariableProperty(
    VariableName="Young's Modulus",
    Property="Unit",
    Value="Pa")
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2.1 [Pa]"]])
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["2 [Pa]"]])
matlProp2.SetVariableProperty(
